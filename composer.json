{
    "name": "semitexa/mcp",
    "description": "Semitexa MCP - a Model Context Protocol server that lets coding agents build and check Semitexa apps",
    "type": "semitexa-module",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "semitexa/core": "*",
        "semitexa/dev": ">=2026.11.04.1133 || dev-master"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Mcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa": {
            "floors": {
                "semitexa/dev": "next"
            }
        },
        "semitexa-module": {
            "extends": null
        }
    },
    "keywords": [
        "semitexa",
        "mcp",
        "model-context-protocol",
        "ai",
        "agents"
    ]
}
